---
import IconPalette from '~icons/carbon/color-palette';
import IconView from '~icons/carbon/view';
import IconFlash from '~icons/carbon/flash';
import IconCollaboration from '~icons/carbon/collaborate';

const features = [
  {
    title: "مجموعه گلچین‌شده",
    description: "استایل‌های دست‌چین شده از تم‌های شرکتی و مینیمال تا سبک‌های پویا و خلاقانه.",
    icon: IconPalette
  },
  {
    title: "پیش‌نمایش‌های واقعی",
    description: "نمونه‌های واقعی از آنچه NotebookLM با هر پرامپت تولید می‌کند؛ بدون حدس و خطا.",
    icon: IconView
  },
  {
    title: "کپی با یک کلیک",
    description: "کپی آنی کدهای ساختاریافته YAML و الصاق سریع در دستورالعمل‌های NotebookLM.",
    icon: IconFlash
  },
  {
    title: "جامعه‌محور و آموزشی",
    description: "توسعه‌یافته در مدرسه هوش مصنوعی یاس با مشارکت جامعه فعالان هوش مصنوعی.",
    icon: IconCollaboration
  }
];
---
<section class="about-features">
  <div class="container">
    <div class="features-grid">
      {features.map(feature => (
        <div class="feature-card">
          <span class="feature-icon"><feature.icon /></span>
          <h3 class="feature-title">{feature.title}</h3>
          <p class="feature-desc">{feature.description}</p>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  .about-features {
    padding: var(--space-4xl) var(--space-lg);
    background: var(--color-accent-soft);
  }
  .container {
    max-width: var(--max-width);
    margin: 0 auto;
  }
  .features-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
    gap: var(--space-xl);
  }
  .feature-card {
    background: var(--color-surface);
    padding: var(--space-2xl);
    border-radius: var(--radius-md);
    border: 1px solid var(--color-border);
    transition: transform var(--duration-normal) var(--ease-out);
  }
  .feature-card:hover {
    transform: translateY(-5px);
  }
  .feature-icon {
    font-size: 2rem;
    display: block;
    margin-bottom: var(--space-lg);
  }
  .feature-title {
    font-size: 1.25rem;
    font-weight: 700;
    margin-bottom: var(--space-md);
  }
  .feature-desc {
    font-size: 0.9375rem;
    color: var(--color-text-secondary);
    line-height: 1.6;
  }
</style>
